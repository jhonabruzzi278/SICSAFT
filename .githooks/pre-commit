#!/bin/sh
echo "🔍 [Git Hook] Verificando calidad y comentarios huérfanos..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '
$h = Get-ChildItem -Path cis/src, core/src, ccp/src, cip/src -Recurse -Include *.ts, *.tsx -ErrorAction SilentlyContinue | Select-String -Pattern "^\s*//\s*$"
if ($h.Count -gt 0) {
    Write-Host "❌ Commit bloqueado: se encontraron comentarios huérfanos." -ForegroundColor Red
    exit 1
}
'
if [ $? -ne 0 ]; then
    exit 1
fi
echo "✔ Verificación pre-commit pasada."
exit 0
