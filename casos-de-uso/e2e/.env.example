# Harness de casos de uso — valores DETERMINISTAS de laboratorio. NO son secretos: este stack
# sólo existe en la máquina que corre los tests, con volúmenes efímeros (`docker compose down -v`
# en el teardown). Nunca reusar en devops/onprem ni devops/prod. Derivado de
# devops/onprem/.env.example.
#
# global-setup lo copia a `.env` (git-ignored) en la primera corrida y completa
# KEYCLOAK_ADMIN_CLIENT_SECRET tras el bootstrap de Keycloak.

# Dominio del harness. Debe coincidir con test-data.mjs (DOMINIO_BASE) y traefik/dynamic.yml.
DOMINIO_BASE=sicsaft.localhost

# --- Postgres (usuario admin de la instancia) ---
POSTGRES_ADMIN_USER=sicsaft_admin
POSTGRES_ADMIN_PASSWORD=e2e-postgres-admin

# --- Keycloak ---
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=e2e-keycloak-db
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- CORE / Base Patrimonial ---
CORE_DB_USER=core
CORE_DB_PASSWORD=e2e-core-db
CORE_SERVICE_TOKEN=5f3c1e9a7b2d84061f5a9c3e8d7b60214a9f2c5e1d8b3760af49c2e5b1d8a3f70

# --- CIP ---
CIP_DB_USER=cip
CIP_DB_PASSWORD=e2e-cip-db
CIP_SERVICE_TOKEN=9a1f4c7e2b5d8036a1f4c7e2b5d8036a1f4c7e2b5d8036a1f4c7e2b5d8036a1f4

# --- Cola de eventos CORE→CIP (pg-boss, ADR-005) ---
EVENTOS_OUTBOX_DB_USER=eventos_outbox
EVENTOS_OUTBOX_DB_PASSWORD=e2e-eventos-outbox-db

# --- Lo completa scripts/keycloak-seed.mjs (client confidencial 'cis-admin') ---
KEYCLOAK_ADMIN_CLIENT_ID=cis-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=PENDIENTE_BOOTSTRAP

# --- Client IDs OIDC públicos — deterministas (mismos nombres que Bootstrap-Keycloak.psm1) ---
APP_QR_VITE_KEYCLOAK_CLIENT_ID=app-qr-sicsaft
CORE_FRONTEND_VITE_KEYCLOAK_CLIENT_ID=core-frontend-sicsaft
CCP_VITE_KEYCLOAK_CLIENT_ID=ccp-sicsaft

# --- Nivel de producto (1 = Básico, 2 = Profesional). El harness usa 2 para ejercitar el CCP
# completo + Dashboard/CIP. ---
NIVEL_PRODUCTO=2
