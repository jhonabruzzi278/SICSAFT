# Variables públicas de Vite (VITE_*) — SPA sin secreto de cliente (PKCE, ver
# src/lib/oidc/pkce.ts). Ver devops/local/README.md "Cliente OIDC real (web_admin)" para cómo
# crear el client OIDC `web-admin-sicsaft` en Keycloak (DOC-022).

# Issuer del realm — ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM} (ADR-004).
VITE_KEYCLOAK_ISSUER=http://id.sicsaft.localhost/realms/sicsaft

# Client ID del client OIDC público (Standard Flow + PKCE, sin secreto) creado para
# `web-admin-sicsaft` en el realm `sicsaft` de Keycloak — redirect URI
# http://localhost:5176/auth/callback en dev.
VITE_KEYCLOAK_CLIENT_ID=cambiar-por-el-client-id-de-la-app-oidc

# URL pública de CIS (Traefik, devops/local/). CIS necesita
# CIS_CORS_ORIGIN=http://localhost:5176 (ver docker-compose.yml) para aceptar requests de este
# origen.
VITE_CIS_URL=http://api.sicsaft.localhost
