# Variables públicas de Vite (VITE_*) — SPA sin secreto de cliente (PKCE, ver
# src/lib/oidc/pkce.ts). Ver devops/local/README.md "Cliente OIDC real (core/frontend)" para cómo
# crear la app OIDC `core-frontend-sicsaft` en Zitadel (DOC-022).

VITE_ZITADEL_ISSUER=http://id.sicsaft.localhost

# Client ID de la app OIDC tipo "User Agent" (SPA, PKCE, sin secreto) creada para
# `core-frontend-sicsaft` en el proyecto "CIS" de Zitadel — redirect URI
# http://localhost:5177/auth/callback en dev.
VITE_ZITADEL_CLIENT_ID=cambiar-por-el-client-id-de-la-app-oidc

# URL pública de CIS (Traefik, devops/local/). CIS necesita
# CIS_CORS_ORIGIN=http://localhost:5177 (ver docker-compose.yml) para aceptar requests de este
# origen. Este portal nunca le habla al backend de CORE directo (ADR-003).
VITE_CIS_URL=http://api.sicsaft.localhost
