<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sicsaft_ink">

    <!-- WebView Principal que carga la PWA de escaneo -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pantalla de Error de Conexión Nativa (visible solo si falla la red/servidor). Misma
         paleta "Control sereno" que el resto del ecosistema (ver activity_conexion.xml) —
         antes tenía colores claros hardcodeados, quedaba fuera de tema y con flash blanco. -->
    <LinearLayout
        android:id="@+id/vista_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/sicsaft_ink"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_badge_destructive"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚠️"
                android:textSize="28sp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_conexion_titulo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/sicsaft_text"
            android:letterSpacing="-0.01"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_conexion_mensaje"
            android:textSize="14sp"
            android:textColor="@color/sicsaft_text_dim"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:paddingBottom="28dp" />

        <Button
            android:id="@+id/boton_reintentar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_conexion_boton_reintentar"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/boton_cambiar_servidor"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_conexion_boton_cambiar" />

    </LinearLayout>

</FrameLayout>
