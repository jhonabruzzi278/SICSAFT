<?xml version="1.0" encoding="utf-8"?>
<!-- Superficie elevada tipo "workspace-card" (ver design.css de los portales web) — agrupa
     visualmente la ruta manual como el paso avanzado/de respaldo frente al auto-descubrimiento. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sicsaft_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/sicsaft_border" />
    <corners android:radius="16dp" />
</shape>
