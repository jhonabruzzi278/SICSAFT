# Variables públicas de Vite (VITE_*) — SPA sin secreto de cliente (PKCE, ver
# src/lib/oidc/pkce.ts). Ver devops/local/README.md § "Cliente OIDC real (WEB)" para cómo crear
# la app OIDC `web-sicsaft` en Zitadel.

VITE_ZITADEL_ISSUER=http://id.sicsaft.localhost

# Client ID de la app OIDC tipo "User Agent" (SPA, PKCE, sin secreto) creada para `web-sicsaft`
# en el proyecto "CIS" de Zitadel — redirect URI http://localhost:5174/auth/callback en dev.
VITE_ZITADEL_CLIENT_ID=cambiar-por-el-client-id-de-la-app-oidc

# URL pública de CIS (Traefik, devops/local/). CIS necesita
# CIS_CORS_ORIGIN=http://localhost:5174 (ya seteado en docker-compose.yml) para aceptar
# requests de este origen.
VITE_CIS_URL=http://api.sicsaft.localhost
