# Copiar a .env (nunca commitear .env real — ya cubierto por el .gitignore raiz) y completar
# valores propios. Todo esto es solo para el ambiente LOCAL — produccion usa secretos distintos
# gestionados aparte (ver devops/README.md).

# --- Postgres (usuario admin, dueño de la instancia) ---
POSTGRES_ADMIN_USER=sicsaft_admin
POSTGRES_ADMIN_PASSWORD=cambiar-esta-clave-local

# --- Redis ---
REDIS_PASSWORD=cambiar-esta-clave-local

# --- Zitadel ---
# Debe tener exactamente 32 caracteres. Generar con: openssl rand -base64 32 | cut -c1-32
ZITADEL_MASTERKEY=cambiar-por-32-caracteres-random
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=cambiar-esta-clave-local
ZITADEL_ADMIN_USERNAME=admin@sicsaft.localhost
ZITADEL_ADMIN_PASSWORD=cambiar-esta-clave-local-Aa1!

# --- CIS (auth OIDC contra Zitadel — ver cis/README.md y ADR-002) ---
# Client ID (o Resource ID de proyecto) de la app OIDC del CIS en Zitadel. Se crea desde el
# dashboard de Zitadel (http://id.sicsaft.localhost) DESPUES de levantar el stack — no existe
# hasta que se crea a mano una vez (ver devops/local/README.md "Qué falta").
CIS_ZITADEL_AUDIENCE=cambiar-por-el-client-id-de-zitadel

# --- Auth servicio-a-servicio CIS -> CORE (ver core/README.md y core/src/common/auth/) ---
# Secreto compartido — mismo valor en ambos servicios, generar con: openssl rand -hex 32
CORE_SERVICE_TOKEN=cambiar-por-64-caracteres-hex-random

# --- Base de datos de CORE / Base Patrimonial (ver base-patrimonial/DOC-004-modelo-contrato.md) ---
# Usuario/base dedicados dentro del mismo postgres compartido (nunca la base `zitadel`).
CORE_DB_USER=core
CORE_DB_PASSWORD=cambiar-esta-clave-local
