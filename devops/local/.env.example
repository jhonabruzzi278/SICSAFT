# Copiar a .env (nunca commitear .env real — ya cubierto por el .gitignore raiz) y completar
# valores propios. Todo esto es solo para el ambiente LOCAL — produccion usa secretos distintos
# gestionados aparte (ver devops/README.md).

# --- Postgres (usuario admin, dueño de la instancia) ---
POSTGRES_ADMIN_USER=sicsaft_admin
POSTGRES_ADMIN_PASSWORD=cambiar-esta-clave-local

# --- Zitadel ---
# Debe tener exactamente 32 caracteres. Generar con: openssl rand -base64 32 | cut -c1-32
ZITADEL_MASTERKEY=cambiar-por-32-caracteres-random
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=cambiar-esta-clave-local
ZITADEL_ADMIN_USERNAME=admin@sicsaft.localhost
ZITADEL_ADMIN_PASSWORD=cambiar-esta-clave-local-Aa1!

# --- CIS (auth OIDC contra Zitadel — ver cis/README.md y ADR-002) ---
# Resource ID del proyecto OIDC del CIS en Zitadel. Se crea desde el dashboard de Zitadel
# (http://id.sicsaft.localhost) DESPUES de levantar el stack — no existe hasta que se crea a
# mano una vez (ver devops/local/README.md "Cliente OIDC real" para el paso a paso completo,
# incluido por qué el tipo de token de la app debe ser JWT, no Bearer/opaco).
CIS_ZITADEL_AUDIENCE=cambiar-por-el-resource-id-del-proyecto-zitadel

# --- Auth servicio-a-servicio CIS -> CORE (ver core/README.md y core/src/common/auth/) ---
# Secreto compartido — mismo valor en ambos servicios, generar con: openssl rand -hex 32
CORE_SERVICE_TOKEN=cambiar-por-64-caracteres-hex-random

# --- Base de datos de CORE / Base Patrimonial (ver base-patrimonial/DOC-004-modelo-contrato.md) ---
# Usuario/base dedicados dentro del mismo postgres compartido (nunca la base `zitadel`).
CORE_DB_USER=core
CORE_DB_PASSWORD=cambiar-esta-clave-local

# --- CIP (Centro de Inteligencia Patrimonial, Fase 6 — ver cip/README.md y DOC-018) ---
# Base de datos propia, separada de `core` (RNF-01). CIP_SERVICE_TOKEN es compartido entre `cip`
# (lo valida, servidor) y `cis` (lo envía, cliente — DOC-019 3, mismo criterio que
# CORE_SERVICE_TOKEN): mismo valor en ambos servicios, generar con: openssl rand -hex 32
CIP_DB_USER=cip
CIP_DB_PASSWORD=cambiar-esta-clave-local
CIP_SERVICE_TOKEN=cambiar-por-64-caracteres-hex-random

# --- Cola de eventos CORE→CIP (pg-boss, ADR-005 — reemplaza a Redis) ---
# Base dedicada, separada de CORE_DB_*/CIP_DB_* a proposito (RNF-01/RNF-05): ninguno de los dos
# sistemas se da acceso a la base de datos del otro, es infraestructura de mensajeria
# explicitamente compartida. Mismo valor en `core` y `cip`.
EVENTOS_OUTBOX_DB_USER=eventos_outbox
EVENTOS_OUTBOX_DB_PASSWORD=cambiar-esta-clave-local

# --- CCP (ex-WEB, Portal, Fase 5 — ver ccp/README.md y devops/local/README.md "Cliente OIDC real (WEB)") ---
# Client ID de la app OIDC tipo "User Agent" (SPA, PKCE) creada para `web-sicsaft` en el proyecto
# "CIS" de Zitadel. Vite las incrusta en build time (build args del Dockerfile), asi que cambiar
# esto requiere reconstruir la imagen (`docker compose build ccp`), no solo reiniciar.
WEB_VITE_ZITADEL_CLIENT_ID=cambiar-por-el-client-id-de-la-app-oidc-web

# --- Administrador del Sistema (DOC-021) — integración real con la API de administración de
# Zitadel para asignar usuarios a organizaciones, ver devops/local/README.md
# "Rol administrador-sistema + integración Zitadel Admin API" ---
# Personal Access Token de un service user con rol IAM/Org Manager (se genera una vez en Console,
# se muestra una sola vez).
ZITADEL_ADMIN_TOKEN=cambiar-por-el-pat-del-service-user
# Resource Id del proyecto "CIS" en Zitadel — mismo id que CIS_ZITADEL_AUDIENCE de arriba.
ZITADEL_PROJECT_ID=cambiar-por-el-resource-id-del-proyecto-zitadel

# --- web_admin (DOC-022) — portal propio del Administrador del Sistema, extraido de
# ccp/AdminPage.tsx. Necesita su propia Application OIDC en Zitadel (no reusa `web-sicsaft`),
# ver devops/local/README.md "Cliente OIDC real (web_admin)" ---
WEB_ADMIN_VITE_ZITADEL_CLIENT_ID=cambiar-por-el-client-id-de-la-app-oidc-web-admin

# --- core/frontend (DOC-022) — portal propio del Directivo (dashboard ejecutivo + designar al
# Profesional de AFT). Vive en core/frontend/ pero le habla a CIS, nunca al backend de CORE
# directo (ADR-003). Necesita su propia Application OIDC en Zitadel, ver
# devops/local/README.md "Cliente OIDC real (core/frontend)" ---
CORE_FRONTEND_VITE_ZITADEL_CLIENT_ID=cambiar-por-el-client-id-de-la-app-oidc-core-frontend

# --- Observabilidad (Prometheus + Loki + Grafana, self-hosted) — ver
# devops/local/README.md "Observabilidad" ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-por-una-contraseña-real
