# Referencia de las variables que necesita devops/prod/docker-compose.yml — NO se completa ni se
# commitea como .env real (Coolify no lee un archivo .env del repo para esto). Cada variable se
# carga a mano en el panel de Coolify, en la pestaña "Environment Variables" del recurso Docker
# Compose de este stack (ver devops/prod/README.md "Despliegue con Coolify"). Mismas variables que
# devops/local/.env.example — ver ese archivo para el detalle largo de qué es cada una; acá solo
# las diferencias reales de producción.

# --- Postgres ---
POSTGRES_ADMIN_USER=sicsaft_admin
POSTGRES_ADMIN_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Zitadel ---
# 32 caracteres exactos: openssl rand -base64 32 | cut -c1-32
ZITADEL_MASTERKEY=
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_USERNAME=admin@sicsaft.cl
ZITADEL_ADMIN_PASSWORD=

# --- CIS ---
# Resource ID del proyecto OIDC del CIS en el Zitadel de PRODUCCIÓN (se crea una vez, después de
# levantar el stack — mismo procedimiento que devops/local/README.md "Cliente OIDC real", contra
# https://id.sicsaft.cl en vez de id.sicsaft.localhost).
CIS_ZITADEL_AUDIENCE=

# --- Auth servicio-a-servicio CIS -> CORE ---
# openssl rand -hex 32 — mismo valor exacto en CIS y CORE.
CORE_SERVICE_TOKEN=

# --- CORE / Base Patrimonial ---
CORE_DB_USER=core
CORE_DB_PASSWORD=

# --- CIP ---
CIP_DB_USER=cip
CIP_DB_PASSWORD=
# openssl rand -hex 32 — mismo valor exacto en CIS y CIP.
CIP_SERVICE_TOKEN=

# --- CCP (Client ID de la app OIDC "web-sicsaft" de producción) ---
WEB_VITE_ZITADEL_CLIENT_ID=

# --- Administrador del Sistema (DOC-021, API de administración de Zitadel) ---
ZITADEL_ADMIN_TOKEN=
ZITADEL_PROJECT_ID=

# --- web_admin (Client ID de su propia app OIDC de producción) ---
WEB_ADMIN_VITE_ZITADEL_CLIENT_ID=

# --- core/frontend (Client ID de su propia app OIDC de producción) ---
CORE_FRONTEND_VITE_ZITADEL_CLIENT_ID=

# --- Mapeo organización Zitadel -> organizacionId de CORE ---
# JSON de una sola línea, ej: {"<org-id-real>":"duoc-uc"}. En local está hardcodeado directo en
# docker-compose.yml (solo hay una organización de prueba) — en producción son las orgs reales de
# clientes, así que es variable, no una constante del compose.
ZITADEL_ORG_ID_MAP=

# --- Observabilidad ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Protege GET /metrics de CIS (público en Coolify, a diferencia de core/cip) — openssl rand -hex
# 32. Prometheus lo recibe como Docker secret (ver `secrets:` de docker-compose.yml), nunca en
# texto plano en observability/prometheus.yml. Sin esta variable, CIS deja /metrics sin
# autenticar (ver cis/src/common/metrics/metrics-token.guard.ts) — no dejar vacío acá.
METRICS_TOKEN=
