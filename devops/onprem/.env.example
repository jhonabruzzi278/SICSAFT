# Copiar a .env por cada instalación de cliente (nunca commitear, nunca reusar entre clientes —
# INST-RNF-03) y completar valores propios de ESE cliente. Ver README.md de esta carpeta para el
# flujo de instalación completo — el orden de los pasos importa (bootstrap de Zitadel antes de
# construir los frontends).
#
# Comparado con devops/local/.env.example: sin GRAFANA_*/observabilidad (INST-RNF-02, no se
# instala en el PC del cliente). CIP SÍ entra en Nivel 1 on-premise desde 2026-08-25 (DOC-025 3,
# cierra INST-Q-01) — antes solo vivía en devops/local/.

# --- Dominio local de este cliente (reemplaza el generico "sicsaft.localhost" en Traefik,
# Zitadel, CORS y las URLs que hornean los frontends en build time). Lo completa
# instalar-cliente.ps1 automaticamente a partir de -ClienteNombre si no se pasa -DominioBase
# explicito — ver New-DominioDesdeNombre. ".test" (RFC 2606) esta reservado para uso local, nunca
# resuelve por internet.
DOMINIO_BASE=cambiar-por-dominio-base-de-este-cliente

# --- Postgres (usuario admin, dueño de la instancia de este cliente) ---
POSTGRES_ADMIN_USER=sicsaft_admin
POSTGRES_ADMIN_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# --- Redis ---
REDIS_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# --- Zitadel (una instancia completa por cliente, no una Organización más en un Zitadel
# compartido — ver DOC-025 4) ---
# Debe tener exactamente 32 caracteres. Generar con: openssl rand -base64 32 | cut -c1-32
ZITADEL_MASTERKEY=cambiar-por-32-caracteres-random
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente
ZITADEL_ADMIN_USERNAME=admin@sicsaft.localhost
ZITADEL_ADMIN_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente-Aa1!

# --- CORE / Base Patrimonial de este cliente ---
CORE_DB_USER=core
CORE_DB_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# --- Auth servicio-a-servicio CIS -> CORE — generar con: openssl rand -hex 32 ---
CORE_SERVICE_TOKEN=cambiar-por-64-caracteres-hex-random

# --- CIP (Centro de Inteligencia Patrimonial / BI) — Nivel 1, base propia separada de `core`
# (RNF-01/RNF-05) ---
CIP_DB_USER=cip
CIP_DB_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# --- Auth servicio-a-servicio CIS -> CIP y CIP -> CORE — generar con: openssl rand -hex 32 ---
CIP_SERVICE_TOKEN=cambiar-por-64-caracteres-hex-random

# ============================================================================
# Todo lo de abajo lo completa bootstrap-zitadel.ps1 — dejar los placeholders hasta correrlo.
# ============================================================================

# Resource ID del proyecto OIDC "CIS" que crea el bootstrap.
CIS_ZITADEL_AUDIENCE=lo-completa-bootstrap-zitadel.ps1

# Mapeo organización de Zitadel -> organizacionId de CORE, ej. '{"<org-id>":"nombre-cliente"}'
# — entre comillas (JSON literal, ver docker-compose.yml para el porqué).
ZITADEL_ORG_ID_MAP=lo-completa-bootstrap-zitadel.ps1

# Personal Access Token del service user que crea el bootstrap (rol IAM/Org Manager) — CIS lo usa
# para la integración con la Management API de Zitadel (alta de organización/usuarios, DOC-021).
# Guardar también en el gestor de secretos del admin (ver aidlc-docs/devops/... "Lo que necesita
# el admin" — se necesita para soportar esta instalación después).
ZITADEL_ADMIN_TOKEN=lo-completa-bootstrap-zitadel.ps1
ZITADEL_PROJECT_ID=lo-completa-bootstrap-zitadel.ps1

# Client ID de cada app OIDC — Vite las hornea en build time, así que construir las imágenes
# (`podman-compose build`) DEBE pasar después de completar estos valores.
APP_QR_VITE_ZITADEL_CLIENT_ID=lo-completa-bootstrap-zitadel.ps1

# --- Portal Directivo y Administrador del Sistema — Nivel 1 (DOC-025 3, rev. 2026-08-25) ---
WEB_ADMIN_VITE_ZITADEL_CLIENT_ID=lo-completa-bootstrap-zitadel.ps1
CORE_FRONTEND_VITE_ZITADEL_CLIENT_ID=lo-completa-bootstrap-zitadel.ps1

# --- CCP (Profesional de AFT completo) — solo Nivel 2 ---
CCP_VITE_ZITADEL_CLIENT_ID=lo-completa-bootstrap-zitadel.ps1
