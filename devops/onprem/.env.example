# Copiar a .env por cada instalación de cliente (nunca commitear, nunca reusar entre clientes —
# INST-RNF-03) y completar valores propios de ESE cliente. Ver README.md de esta carpeta para el
# flujo de instalación completo — el orden de los pasos importa (bootstrap de Keycloak antes de
# construir los frontends).
#
# Comparado con devops/local/.env.example: sin GRAFANA_*/observabilidad (INST-RNF-02, no se
# instala en el PC del cliente). Modelo de niveles unificado con sicsaft-core.exe (2026-09-02):
# Nivel 1 = APP QR + CCP completo + Directivo + Admin + CIP; Nivel 2 solo suma el módulo
# Dashboard/indicadores (CIP) vía el flag NIVEL_PRODUCTO de abajo. No hay servicios gateados por
# perfil de Compose.

# --- Dominio local de este cliente (reemplaza el generico "sicsaft.localhost" en Traefik,
# Keycloak, CORS y las URLs que hornean los frontends en build time). Lo completa
# instalar-cliente.ps1 automaticamente a partir de -ClienteNombre si no se pasa -DominioBase
# explicito — ver New-DominioDesdeNombre. Termina en ".localhost" (RFC 6761, no ".test" como hasta
# el 2026-08-26): cualquier hostname bajo ".localhost" resuelve solo a loopback Y se trata como
# secure context en el navegador — sin esto último, crypto.subtle/crypto.randomUUID no existen y
# el login PKCE de los 4 portales queda roto (bug real encontrado, ver instalar-cliente.ps1).
DOMINIO_BASE=cambiar-por-dominio-base-de-este-cliente

# --- Postgres (usuario admin, dueño de la instancia de este cliente) ---
POSTGRES_ADMIN_USER=sicsaft_admin
POSTGRES_ADMIN_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# --- Keycloak (ADR-004 — una instancia completa por cliente, no un realm más en un Keycloak
# compartido — mismo criterio que ya usaba Zitadel, ver DOC-025 4) ---
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente
# Admin humano del realm "master" — solo lo usa bootstrap-keycloak.ps1 para aprovisionar todo lo
# demás (realm "sicsaft", roles, clients OIDC) sin pasar por la Console. A diferencia de Zitadel,
# Keycloak no exige mayuscula+minuscula+digito+simbolo en esta contraseña (sin política de
# password por defecto) — no hace falta el sufijo especial que sí necesitaba
# ZITADEL_ADMIN_PASSWORD.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# --- CORE / Base Patrimonial de este cliente ---
CORE_DB_USER=core
CORE_DB_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# --- Auth servicio-a-servicio CIS -> CORE — generar con: openssl rand -hex 32 ---
CORE_SERVICE_TOKEN=cambiar-por-64-caracteres-hex-random

# --- CIP (Centro de Inteligencia Patrimonial / BI) — Nivel 1, base propia separada de `core`
# (RNF-01/RNF-05) ---
CIP_DB_USER=cip
CIP_DB_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# --- Auth servicio-a-servicio CIS -> CIP y CIP -> CORE — generar con: openssl rand -hex 32 ---
CIP_SERVICE_TOKEN=cambiar-por-64-caracteres-hex-random

# --- Cola de eventos CORE→CIP (pg-boss, ADR-005 — reemplaza a Redis), base dedicada separada de
# CORE_DB_*/CIP_DB_* (RNF-01/RNF-05) ---
EVENTOS_OUTBOX_DB_USER=eventos_outbox
EVENTOS_OUTBOX_DB_PASSWORD=cambiar-por-una-clave-unica-de-este-cliente

# ============================================================================
# Todo lo de abajo lo completa bootstrap-keycloak.ps1 — dejar los placeholders hasta correrlo.
# ============================================================================

# Client confidencial (service account) que crea el bootstrap para que CIS use la Admin REST API
# de Keycloak (alta de organización/usuarios, DOC-021) — ver lib/Bootstrap-Keycloak.psm1.
KEYCLOAK_ADMIN_CLIENT_ID=lo-completa-bootstrap-keycloak.ps1
KEYCLOAK_ADMIN_CLIENT_SECRET=lo-completa-bootstrap-keycloak.ps1

# Client ID de cada app OIDC (público, PKCE) — Vite las hornea en build time, así que construir
# las imágenes (`podman-compose build`) DEBE pasar después de completar estos valores.
APP_QR_VITE_KEYCLOAK_CLIENT_ID=lo-completa-bootstrap-keycloak.ps1

# --- Portal Directivo y Administrador del Sistema — Nivel 1 (DOC-025 3, rev. 2026-08-25) ---
WEB_ADMIN_VITE_KEYCLOAK_CLIENT_ID=lo-completa-bootstrap-keycloak.ps1
CORE_FRONTEND_VITE_KEYCLOAK_CLIENT_ID=lo-completa-bootstrap-keycloak.ps1

# --- CCP (Profesional de AFT completo) — todos los niveles ---
CCP_VITE_KEYCLOAK_CLIENT_ID=lo-completa-bootstrap-keycloak.ps1

# --- Nivel de producto contratado (1 = Básico, 2 = Profesional). instalar-cliente.ps1 lo pone a
# partir de -Nivel. Lo hornea el build de `ccp` como VITE_SICSAFT_NIVEL: en `1` oculta el módulo
# Dashboard/indicadores (CIP); en `2` lo muestra. Es la única diferencia entre niveles. ---
NIVEL_PRODUCTO=cambiar-por-nivel-de-producto
