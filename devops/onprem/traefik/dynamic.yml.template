# Config dinamica de Traefik para instalaciones onprem — provider "file" (ruteo estatico), mismo
# criterio que devops/local/traefik/dynamic.yml. Sin dashboard expuesto a proposito (INST-RNF-02,
# ver aidlc-docs/devops/requirements/REQUIREMENTS.md) y sin router de `grafana` (no se instala
# observabilidad en el PC del cliente).
http:
  routers:
    keycloak:
      rule: "Host(`id.__DOMINIO_BASE__`)"
      entryPoints:
        - web
      service: keycloak
    cis:
      rule: "Host(`api.__DOMINIO_BASE__`)"
      entryPoints:
        - web
      service: cis
    app-qr-sicsaft:
      rule: "Host(`qr.__DOMINIO_BASE__`)"
      entryPoints:
        - web
      service: app-qr-sicsaft
    # Los 3 routers de abajo solo resuelven a algo si el perfil "nivel2" levantó esos servicios —
    # Traefik no falla si el servicio no está corriendo, solo devuelve 502 hasta que se levante.
    ccp:
      rule: "Host(`ccp.__DOMINIO_BASE__`)"
      entryPoints:
        - web
      service: ccp
    core-frontend:
      rule: "Host(`directivo.__DOMINIO_BASE__`)"
      entryPoints:
        - web
      service: core-frontend

  services:
    keycloak:
      loadBalancer:
        servers:
          - url: "http://keycloak:8080"
    cis:
      loadBalancer:
        servers:
          - url: "http://cis:3000"
    app-qr-sicsaft:
      loadBalancer:
        servers:
          - url: "http://app-qr-sicsaft:8080"
    ccp:
      loadBalancer:
        servers:
          - url: "http://ccp:8080"
    core-frontend:
      loadBalancer:
        servers:
          - url: "http://core-frontend:8080"
