# Variables públicas de Vite (VITE_*) — esto es una SPA sin secreto de cliente (PKCE, ver
# src/lib/oidc/pkce.ts), no hay nada acá que no termine en el bundle del navegador igual.
# Ver devops/local/README.md § "Cliente OIDC real" para cómo crear la app OIDC en Zitadel.

# Mismo issuer que usa CIS (ZITADEL_ISSUER en devops/local/docker-compose.yml).
VITE_ZITADEL_ISSUER=http://id.sicsaft.localhost

# Client ID de la app OIDC tipo "User Agent" (SPA, PKCE, sin secreto) creada para
# app-qr-sicsaft en el proyecto "CIS" de Zitadel — redirect URI
# http://localhost:5173/auth/callback en dev. Habilitar el scope/grant offline_access
# (Token Settings) para que el refresh token funcione (TASK-007 usa refresh explícito, no
# re-login silencioso).
VITE_ZITADEL_CLIENT_ID=cambiar-por-el-client-id-de-la-app-oidc

# URL pública de CIS — dentro de devops/local/, expuesta por Traefik en
# http://api.sicsaft.localhost (ver devops/local/traefik/dynamic.yml). CIS necesita
# CIS_CORS_ORIGIN=http://localhost:5173 (ya seteado en docker-compose.yml) para aceptar
# requests de este origen.
VITE_CIS_URL=http://api.sicsaft.localhost
