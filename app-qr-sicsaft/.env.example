# Variables públicas de Vite (VITE_*) — esto es una SPA sin secreto de cliente (PKCE, ver
# src/lib/oidc/pkce.ts), no hay nada acá que no termine en el bundle del navegador igual.
# Ver devops/local/README.md "Cliente OIDC real" para cómo crear el client OIDC en Keycloak.

# Mismo issuer que usa CIS — ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM} (ADR-004,
# ver devops/local/docker-compose.yml).
VITE_KEYCLOAK_ISSUER=http://id.sicsaft.localhost/realms/sicsaft

# Client ID del client OIDC público (Standard Flow + PKCE, sin secreto) creado para
# app-qr-sicsaft en el realm `sicsaft` de Keycloak — redirect URI
# http://localhost:5173/auth/callback en dev. Habilitar el scope/mapper offline_access para que
# el refresh token funcione (TASK-007 usa refresh explícito, no re-login silencioso).
VITE_KEYCLOAK_CLIENT_ID=cambiar-por-el-client-id-de-la-app-oidc

# URL pública de CIS — dentro de devops/local/, expuesta por Traefik en
# http://api.sicsaft.localhost (ver devops/local/traefik/dynamic.yml). CIS necesita
# CIS_CORS_ORIGIN=http://localhost:5173 (ya seteado en docker-compose.yml) para aceptar
# requests de este origen.
VITE_CIS_URL=http://api.sicsaft.localhost
