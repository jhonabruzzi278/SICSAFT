# Modo Vite para la suite e2e de Playwright (tests/) — ver plan de e2e en HANDOFF 7. Valores
# dummy, no son secretos (mismo criterio que .env.example): en este modo la red va mockeada con
# MSW (src/mocks/), Keycloak nunca se llama de verdad.
VITE_MOCK_API=true
VITE_KEYCLOAK_ISSUER=http://mock.keycloak.invalid/realms/sicsaft
VITE_KEYCLOAK_CLIENT_ID=mock-client
VITE_CIS_URL=http://mock-cis.invalid
