{
  "name": "ccp-sicsaft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portal WEB SICSAFT — administracion patrimonial (Fase 5).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{js,ts}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
