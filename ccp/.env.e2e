# Modo Vite para la suite e2e de Playwright (tests/) — mismo criterio que
# app-qr-sicsaft/.env.e2e: valores dummy, no secretos, la red va mockeada con MSW (src/mocks/),
# Zitadel nunca se llama de verdad.
VITE_MOCK_API=true
VITE_ZITADEL_ISSUER=http://mock.zitadel.invalid
VITE_ZITADEL_CLIENT_ID=mock-client
VITE_CIS_URL=http://mock-cis.invalid
